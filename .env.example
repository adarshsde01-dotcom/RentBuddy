# =================================================================
# RentBuddy Environment Configuration
# =================================================================

# -----------------------------------------------------------------
# Cloudinary Image Management (Unsigned Direct Upload Workflow)
# -----------------------------------------------------------------
# 1. Sign up for a free account at https://cloudinary.com (25GB free tier).
# 2. Go to Settings -> Upload -> Upload presets -> Add upload preset.
# 3. Set Signing Mode to "Unsigned" and name it (e.g., rentbuddy_preset).
# 4. Copy your Cloud Name and Preset Name below.
#
# NOTE: Never put your Cloudinary API Secret in client-side code!
# Unsigned presets are secure for client-side uploads.
# If preset is left blank, the app runs in safe local preview mode.
# -----------------------------------------------------------------

VITE_CLOUDINARY_CLOUD_NAME=dqczk3bz
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_here
VITE_CLOUDINARY_API_KEY=your_public_api_key_optional

# -----------------------------------------------------------------
# Optional Supabase Backend (If connecting full remote DB)
# -----------------------------------------------------------------
# VITE_SUPABASE_URL=https://xyzcompany.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
